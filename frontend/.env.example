# RakshaSutra Frontend Environment Configuration Template
# Only required if deploying Frontend separately from Backend (e.g. on Vercel / Netlify / Cloudflare Pages)
# If deploying full-stack via Docker / Render / Cloud Run, leave this empty to use relative same-origin routing.

# Backend API Endpoint URL (No trailing slash)
# Example: https://rakshasutra.onrender.com or https://api.yourdomain.com
VITE_API_URL=
